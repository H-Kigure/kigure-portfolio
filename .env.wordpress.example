WP_PORT=8080
PHPMYADMIN_PORT=8081
MAILCATCHER_WEB_PORT=1080
MAILCATCHER_SMTP_PORT=1025

WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=wordpress
WP_DB_ROOT_PASSWORD=wordpress-root

# Local WordPress installation and administrator settings.
# WP_SITE_URL defaults to http://localhost:${WP_PORT} when omitted.
WP_SITE_TITLE='example site'
WP_ADMIN_USER=portfolio-admin
WP_ADMIN_PASSWORD='change-this-local-password'
WP_ADMIN_EMAIL=admin@example.test
